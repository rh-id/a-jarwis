<resources>
    <!-- Base application theme.-->
    <style name="Theme.Asnapblur" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/red_800</item>
        <item name="colorPrimaryVariant">@color/light_blue_300</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/magenta_600</item>
        <item name="colorSecondaryVariant">@color/orange_800</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/gray_700</item>
    </style>

    <style name="Theme.Asnapblur.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Material You dynamic color overlay, applied at runtime when the
         device supports it. Variant colors point at day/night wrapper colors
         so themed surfaces follow the system palette in both light and dark. -->
    <style name="Theme.Asnapblur.Overlay.DynamicColors" parent="ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="colorPrimaryVariant">@color/dynamic_primary_variant</item>
        <item name="colorSecondaryVariant">@color/dynamic_secondary_variant</item>
    </style>

    <!-- Re-points the MaterialButton default style at the M3 text button:
         the Material library has no textButtonStyle theme attr for a plain
         defStyleAttr, so code-built text buttons wrap their context in this
         overlay and construct with materialButtonStyle. Explicit empty
         parent: the empty name suppresses the dotted-name implicit-parent
         lookup (Theme.Asnapblur.Overlay is not a resource) -->
    <style name="Theme.Asnapblur.Overlay.TextButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
    </style>

    <style name="Theme.Asnapblur.BorderlessMenuButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">70dp</item>
        <item name="background">?attr/selectableItemBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/daynight_gray_700_white</item>
        <item name="android:textSize">@dimen/text_nav_menu</item>
        <item name="android:textStyle">normal</item>
        <item name="iconPadding">24dp</item>
        <item name="iconTint">@color/daynight_gray_700_white</item>
    </style>

    <style name="Theme.Asnapblur.HomeMenuButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/daynight_gray_700_white</item>
        <item name="android:textSize">@dimen/text_nav_menu</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_margin">16dp</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">?attr/colorSecondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconSize">48dp</item>
        <item name="iconTint">?attr/colorSecondary</item>
        <item name="iconGravity">top</item>
    </style>
</resources>