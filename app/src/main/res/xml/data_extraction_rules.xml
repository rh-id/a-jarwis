<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!-- the on-demand AI models (~600 MB) are re-downloadable, backing
             them up would bloat the quota and a restore would resurrect
             deleted models (see ModelStorageManager) -->
        <exclude domain="file" path="ml-engine/"/>
        <!-- the last-used timestamps of the models: restoring them after a
             model was deleted would resurrect stale "last used" hints -->
        <exclude domain="sharedpref" path="ml-engine-model-usage.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- same excludes as the cloud backup, for the device-to-device transfer -->
        <exclude domain="file" path="ml-engine/"/>
        <exclude domain="sharedpref" path="ml-engine-model-usage.xml"/>
    </device-transfer>
</data-extraction-rules>
