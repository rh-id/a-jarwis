<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!-- the on-demand AI models (~600 MB) are re-downloadable, backing them
         up would bloat the quota and a restore would resurrect deleted
         models (see ModelStorageManager) -->
    <exclude domain="file" path="ml-engine/" />
    <!-- the last-used timestamps of the models (written by ModelUsageStore
         into shared_prefs/ml-engine-model-usage.xml): restoring them after
         a model was deleted would resurrect stale "last used" hints -->
    <exclude domain="sharedpref" path="ml-engine-model-usage.xml" />
</full-backup-content>
